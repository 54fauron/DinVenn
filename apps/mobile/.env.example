# Bruk maskinens LAN-IP ved testing på fysisk telefon mot lokal Supabase.
EXPO_PUBLIC_SUPABASE_URL=http://192.168.1.10:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-anon-or-cloud-publishable-key
# Offentlig HTTPS-adresse til portalen for e-postbekreftelse/passordtilbakestilling.
EXPO_PUBLIC_PORTAL_URL=http://localhost:5173
# Kreves for kart i en selvstendig Android-app; ikke nødvendig i Expo Go/iOS.
# Begrens nøkkelen til Maps SDK for Android, no.dinvenn.pilot og signeringssertifikatets SHA-1.
GOOGLE_MAPS_ANDROID_API_KEY=
